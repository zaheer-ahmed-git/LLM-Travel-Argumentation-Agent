OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
USE_LLM=false

# Async SQLAlchemy URL (asyncpg)
DATABASE_URL=postgresql+asyncpg://workflow:workflow@localhost:5432/workflow_automation
DATABASE_ECHO=false
POOL_SIZE=5
MAX_OVERFLOW=5
POOL_RECYCLE=1800

API_HOST=0.0.0.0
API_PORT=8000

COMPRESSION_MAX_CHARS=800
COMPRESSION_TARGET_RATIO=0.6
QC_PASS_THRESHOLD=0.7
MAX_REWORK_CYCLES=2
MEMORY_TOP_K=5
